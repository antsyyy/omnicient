# Omnicient backend configuration.
#
# Copy to .env and edit.  Every value except the Neo4j password has a working
# default, so a local run needs only NEO4J_PASSWORD.
#
# Never commit a real .env: it is listed in .gitignore.

# --- database --------------------------------------------------------------
# Neo4j is the primary and only datastore. Entities and relationships are
# stored as native nodes and edges; there is no second database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# Required. Set this to the password the Neo4j instance was created with;
# under Docker Compose it is read from NEO4J_PASSWORD in the repository .env.
NEO4J_PASSWORD=
# Neo4j Community serves a single database, named "neo4j".
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=25
# Seconds to wait for Neo4j at startup; containers are often still recovering.
NEO4J_STARTUP_TIMEOUT=30

# --- mode ------------------------------------------------------------------
# true  -> investigations use the built-in synthetic dataset (no network)
# false -> investigations query live public sources
OMNICIENT_DEMO_MODE=true

# --- crawler budget --------------------------------------------------------
OMNICIENT_MAX_DEPTH=2
OMNICIENT_MAX_PAGES=50
OMNICIENT_REQUEST_TIMEOUT=10
# Seconds between outbound requests to the same host. Keep this polite:
# Omnicient does not implement rate-limit evasion of any kind.
OMNICIENT_REQUEST_DELAY=1.0
OMNICIENT_MAX_RESPONSE_BYTES=2000000
OMNICIENT_MAX_REDIRECTS=3
OMNICIENT_RESPECT_ROBOTS=true

# Only enable on an isolated test network: it disables the SSRF guard that
# blocks localhost, RFC1918 ranges, link-local and cloud metadata addresses.
OMNICIENT_ALLOW_PRIVATE_NETWORKS=false

OMNICIENT_USER_AGENT=Omnicient/0.1 (OSINT research tool; public data only)

# --- server ----------------------------------------------------------------
OMNICIENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OMNICIENT_LOG_LEVEL=INFO

# --- tests -----------------------------------------------------------------
# The suite wipes whatever database it connects to. Point these at a scratch
# instance; they fall back to the NEO4J_* values above.
# NEO4J_TEST_URI=bolt://localhost:7687
# NEO4J_TEST_PASSWORD=
